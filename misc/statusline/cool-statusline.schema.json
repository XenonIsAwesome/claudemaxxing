{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "statusline.schema.json",
  "title": "Claude Code boxed statusline configuration",
  "description": "Configuration for statusline.py. Every property is optional; missing ones use the built-in defaults.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_comment": {
      "type": "string",
      "description": "Ignored; free-form note."
    },
    "icons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "house": {
          "type": "string",
          "description": "Icon in front of the working directory.",
          "default": ""
        },
        "git": {
          "type": "string",
          "description": "Icon in front of the git branch.",
          "default": ""
        },
        "worktree": {
          "type": "string",
          "description": "Icon in front of the linked-worktree name (only shown inside a worktree).",
          "default": "⧉"
        },
        "model": {
          "type": "string",
          "description": "Icon at the start of the model badge.",
          "default": "✱"
        },
        "context": {
          "type": "string",
          "description": "Icon of the context-window row.",
          "default": "󰧑"
        },
        "five_hour": {
          "type": "string",
          "description": "Icon of the 5-hour session usage row.",
          "default": ""
        },
        "weekly": {
          "type": "string",
          "description": "Icon of the weekly usage row.",
          "default": ""
        },
        "session_duration": {
          "type": "string",
          "description": "Icon in front of the session duration in the top border.",
          "default": ""
        },
        "tokens_in": {
          "type": "string",
          "description": "Icon in front of the input-token count in the footer.",
          "default": ""
        },
        "tokens_out": {
          "type": "string",
          "description": "Icon in front of the output-token count in the footer.",
          "default": ""
        },
        "throughput": {
          "type": "string",
          "description": "Icon in front of the tokens-per-minute figure in the footer.",
          "default": "●"
        },
        "ahead": {
          "type": "string",
          "description": "Symbol for commits ahead of upstream.",
          "default": "↑"
        },
        "behind": {
          "type": "string",
          "description": "Symbol for commits behind upstream.",
          "default": "↓"
        },
        "clock": {
          "type": "string",
          "description": "Icon in front of the clock element.",
          "default": ""
        },
        "cost": {
          "type": "string",
          "description": "Prefix of the cost element.",
          "default": "$"
        }
      },
      "description": "Glyphs (Nerd Font). Use an empty string to hide an icon."
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "string",
          "description": "Label of the context-window row.",
          "default": "ctx"
        },
        "five_hour": {
          "type": "string",
          "description": "Label of the 5-hour session row.",
          "default": "5h"
        },
        "weekly": {
          "type": "string",
          "description": "Label of the weekly row.",
          "default": "7d"
        },
        "tokens_in": {
          "type": "string",
          "description": "Footer label for input tokens.",
          "default": "in"
        },
        "tokens_out": {
          "type": "string",
          "description": "Footer label for output tokens.",
          "default": "out"
        },
        "throughput_unit": {
          "type": "string",
          "description": "Unit shown after the throughput number.",
          "default": "t/m"
        },
        "of": {
          "type": "string",
          "description": "Word between used and total context size (\"44.7K of 1.0M\").",
          "default": "of"
        },
        "resets": {
          "type": "string",
          "description": "Word before the reset countdown.",
          "default": "resets"
        },
        "not_available": {
          "type": "string",
          "description": "Text shown when a rate-limit row has no data (non-subscription plans).",
          "default": "n/a"
        },
        "default_model": {
          "type": "string",
          "description": "Model name used when Claude Code does not provide one.",
          "default": "Claude"
        },
        "effort_separator": {
          "type": "string",
          "description": "Text between the model name and the effort level in the badge.",
          "default": " · "
        },
        "throughput_unit_sec": {
          "type": "string",
          "default": "t/s",
          "description": "Unit label of the tok_per_sec element."
        }
      },
      "description": "All text shown in the statusline."
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/definitions/color",
          "description": "Values (token counts, sizes).",
          "default": "#c0caf5"
        },
        "dim": {
          "$ref": "#/definitions/color",
          "description": "Labels and secondary text.",
          "default": "#565f89"
        },
        "path": {
          "$ref": "#/definitions/color",
          "description": "House icon and working directory.",
          "default": "#8ecbff"
        },
        "git": {
          "$ref": "#/definitions/color",
          "description": "Git icon, branch, ahead/behind counts and worktree.",
          "default": "#a8f5a2"
        },
        "session_id": {
          "$ref": "#/definitions/color",
          "description": "Session id in the top border.",
          "default": "#565f89"
        },
        "session_duration": {
          "$ref": "#/definitions/color",
          "description": "Clock icon and duration in the top border.",
          "default": "#7dcfff"
        },
        "context_icon": {
          "$ref": "#/definitions/color",
          "description": "Icon of the context row.",
          "default": "#bb9af7"
        },
        "five_hour_icon": {
          "$ref": "#/definitions/color",
          "description": "Icon of the 5-hour row.",
          "default": "#7dcfff"
        },
        "weekly_icon": {
          "$ref": "#/definitions/color",
          "description": "Icon of the weekly row.",
          "default": "#7aa2f7"
        },
        "tokens_in_icon": {
          "$ref": "#/definitions/color",
          "description": "Input-token arrow in the footer.",
          "default": "#7dcfff"
        },
        "tokens_out_icon": {
          "$ref": "#/definitions/color",
          "description": "Output-token arrow in the footer.",
          "default": "#bb9af7"
        },
        "throughput": {
          "$ref": "#/definitions/color",
          "description": "Throughput figure in the footer.",
          "default": "#7dcfff"
        },
        "clock": {
          "$ref": "#/definitions/color",
          "description": "Clock element.",
          "default": "#7dcfff"
        },
        "cost": {
          "$ref": "#/definitions/color",
          "description": "Cost element.",
          "default": "#e0af68"
        },
        "lines_added": {
          "$ref": "#/definitions/color",
          "description": "Lines-changed element, added count.",
          "default": "#a8f5a2"
        },
        "lines_removed": {
          "$ref": "#/definitions/color",
          "description": "Lines-changed element, removed count.",
          "default": "#ff5c7a"
        },
        "version": {
          "$ref": "#/definitions/color",
          "description": "Claude Code version element.",
          "default": "#565f89"
        }
      },
      "description": "Text and icon colors (#rrggbb)."
    },
    "bars": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "left": {
              "type": "string",
              "description": "Left end cap of every bar.",
              "default": "◖"
            },
            "right": {
              "type": "string",
              "description": "Right end cap of every bar.",
              "default": "◗"
            }
          },
          "description": "End caps of the progress bars."
        },
        "fill": {
          "type": "string",
          "description": "Character repeated for every bar cell (filled and empty).",
          "default": "█",
          "minLength": 1
        },
        "track_color": {
          "$ref": "#/definitions/color",
          "description": "Color of the unfilled part of a bar.",
          "default": "#27332e"
        },
        "color_stops": {
          "$ref": "#/definitions/colorStops",
          "description": "Bar and percentage color by usage. The stop with the highest 'from' that is <= the percentage wins.",
          "default": [
            {
              "from": 0,
              "color": "#39ff88"
            },
            {
              "from": 80,
              "color": "#ffd84a"
            },
            {
              "from": 91,
              "color": "#ff5c7a"
            }
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color_stops": {
              "oneOf": [
                {
                  "$ref": "#/definitions/colorStops"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Color stops for the context bar only; null uses the shared bars.color_stops.",
              "default": null
            }
          },
          "description": "Overrides for the context bar."
        },
        "five_hour": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color_stops": {
              "oneOf": [
                {
                  "$ref": "#/definitions/colorStops"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Color stops for the 5-hour bar only; null uses the shared bars.color_stops.",
              "default": null
            }
          },
          "description": "Overrides for the 5-hour bar."
        },
        "weekly": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color_stops": {
              "oneOf": [
                {
                  "$ref": "#/definitions/colorStops"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Color stops for the weekly bar only; null uses the shared bars.color_stops.",
              "default": null
            }
          },
          "description": "Overrides for the weekly bar."
        }
      },
      "description": "Progress bar appearance and usage-based colors."
    },
    "border": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gradient": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/definitions/color",
              "description": "Start color.",
              "default": "#39ff88"
            },
            "to": {
              "$ref": "#/definitions/color",
              "description": "End color.",
              "default": "#6b7280"
            },
            "swap_point": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5,
              "description": "Fraction (0-1) of the box width where the gradient has fully changed from 'from' to 'to'. Lower values finish the fade earlier; 1 spreads it across the whole box width."
            }
          },
          "default": {
            "from": "#39ff88",
            "to": "#6b7280",
            "swap_point": 0.5
          },
          "description": "Left-to-right color gradient of the whole box border."
        },
        "chars": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top_left": {
              "type": "string",
              "description": "Top-left corner.",
              "default": "╭",
              "minLength": 1,
              "maxLength": 1
            },
            "top_right": {
              "type": "string",
              "description": "Top-right corner.",
              "default": "╮",
              "minLength": 1,
              "maxLength": 1
            },
            "bottom_left": {
              "type": "string",
              "description": "Bottom-left corner.",
              "default": "╰",
              "minLength": 1,
              "maxLength": 1
            },
            "bottom_right": {
              "type": "string",
              "description": "Bottom-right corner.",
              "default": "╯",
              "minLength": 1,
              "maxLength": 1
            },
            "horizontal": {
              "type": "string",
              "description": "Horizontal line.",
              "default": "─",
              "minLength": 1,
              "maxLength": 1
            },
            "vertical": {
              "type": "string",
              "description": "Vertical line.",
              "default": "│",
              "minLength": 1,
              "maxLength": 1
            },
            "tee_left": {
              "type": "string",
              "description": "Left end of a row separator.",
              "default": "├",
              "minLength": 1,
              "maxLength": 1
            },
            "tee_right": {
              "type": "string",
              "description": "Right end of a row separator.",
              "default": "┤",
              "minLength": 1,
              "maxLength": 1
            }
          },
          "description": "Box-drawing characters (one character each)."
        }
      },
      "description": "Box border."
    },
    "model_badge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gradient": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/definitions/color",
              "description": "Start color.",
              "default": "#e0af68"
            },
            "to": {
              "$ref": "#/definitions/color",
              "description": "End color.",
              "default": "#e0603c"
            },
            "swap_point": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1.0,
              "description": "Fraction (0-1) of the badge width where the gradient has fully changed from 'from' to 'to'. Lower values finish the fade earlier; 1 spreads it across the whole badge width."
            }
          },
          "default": {
            "from": "#e0af68",
            "to": "#e0603c",
            "swap_point": 1.0
          },
          "description": "Left-to-right background gradient of the model badge."
        },
        "text_color": {
          "$ref": "#/definitions/color",
          "description": "Badge text color.",
          "default": "#1a1b26"
        },
        "bold": {
          "type": "boolean",
          "description": "Bold badge text.",
          "default": true
        },
        "caps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "left": {
              "type": "string",
              "description": "Left end cap (colored with the gradient start).",
              "default": ""
            },
            "right": {
              "type": "string",
              "description": "Right end cap (colored with the gradient end).",
              "default": ""
            }
          },
          "description": "Rounded end caps of the badge."
        }
      },
      "description": "Model and effort badge."
    },
    "sparkline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chars": {
          "type": "string",
          "description": "Characters from lowest to highest bar.",
          "default": "▁▂▃▄▅▆▇█",
          "minLength": 1
        },
        "empty_char": {
          "type": "string",
          "description": "Filler drawn where there is no history yet.",
          "default": "─"
        },
        "color_from": {
          "$ref": "#/definitions/color",
          "description": "Color of the lowest values.",
          "default": "#39ff88"
        },
        "color_to": {
          "$ref": "#/definitions/color",
          "description": "Color of the highest values.",
          "default": "#ff5c7a"
        },
        "history_samples": {
          "type": "integer",
          "minimum": 1,
          "default": 120,
          "description": "Maximum number of throughput samples kept."
        },
        "sample_interval_seconds": {
          "type": "number",
          "minimum": 0,
          "default": 5,
          "description": "Minimum seconds between two stored samples."
        }
      },
      "description": "Throughput sparkline at the end of the footer row."
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show_ahead_behind": {
          "type": "boolean",
          "default": true,
          "description": "Show (↑N ↓N); a zero count and a branch without upstream are hidden."
        },
        "show_worktree": {
          "type": "boolean",
          "default": true,
          "description": "Show the worktree name when inside a linked git worktree."
        }
      },
      "description": "Git segment options."
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "description": "Box layout: rows, top/bottom bars, sizes.",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/item"
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "left": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/item"
                    }
                  },
                  "center": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/item"
                    }
                  },
                  "right": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/item"
                    }
                  },
                  "gap": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Columns between items in this row."
                  },
                  "divider": {
                    "type": "boolean",
                    "description": "Draw a divider line above this row."
                  },
                  "columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5,
                    "description": "Make this a grid row with N equal columns (max 5)."
                  },
                  "col_widths": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "description": "Relative column widths, e.g. [2,1,1]."
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/item"
                    },
                    "description": "Grid rows: items placed left to right, wrapping onto new lines."
                  },
                  "equal_bars": {
                    "type": "boolean",
                    "description": "Override layout.equal_bars for this row."
                  }
                }
              }
            ]
          },
          "default": [
            {
              "left": [
                "dir",
                "git"
              ],
              "right": [
                "model"
              ]
            },
            {
              "left": [
                {
                  "id": "context",
                  "width": "flex"
                }
              ]
            },
            {
              "left": [
                {
                  "id": "five_hour",
                  "width": "flex"
                },
                {
                  "id": "seven_day",
                  "width": "flex"
                }
              ],
              "gap": 3
            },
            {
              "left": [
                "in_tok",
                "out_tok",
                "tok_per_min",
                {
                  "id": "throughput",
                  "width": "flex"
                }
              ]
            }
          ],
          "description": "Rows top to bottom. Each row has left / center / right groups of elements; order inside a group is the draw order."
        },
        "top": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "left": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/item"
              }
            },
            "center": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/item"
              }
            },
            "right": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/item"
              }
            }
          },
          "description": "Items on the top border bar."
        },
        "bottom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "left": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/item"
              }
            },
            "center": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/item"
              }
            },
            "right": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/item"
              }
            }
          },
          "description": "Items on the bottom border bar."
        },
        "gap": {
          "type": "integer",
          "minimum": 0,
          "default": 2,
          "description": "Default columns between items in a row."
        },
        "border_gap": {
          "type": "integer",
          "minimum": 0,
          "default": 2,
          "description": "Columns between items on the top/bottom bars."
        },
        "row_dividers": {
          "type": "boolean",
          "default": true,
          "description": "Draw divider lines between rows."
        },
        "clock_format": {
          "type": "string",
          "default": "%H:%M",
          "description": "Default strftime format of the clock element."
        },
        "min_width": {
          "type": "integer",
          "minimum": 20,
          "default": 60,
          "description": "Minimum box width in columns."
        },
        "max_width": {
          "type": "integer",
          "minimum": 20,
          "default": 1000,
          "description": "Maximum box width in columns."
        },
        "side_margin": {
          "type": "integer",
          "minimum": 0,
          "default": 4,
          "description": "Columns subtracted from the terminal width."
        },
        "label_width": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "description": "Width bar labels are padded to."
        },
        "equal_bars": {
          "type": "boolean",
          "default": false,
          "description": "Render all bars in a row at the width of the narrowest one."
        }
      }
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Hex color, #rrggbb."
    },
    "colorStop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "color"
      ],
      "properties": {
        "from": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Lowest percentage (inclusive) this color applies to."
        },
        "color": {
          "$ref": "#/definitions/color"
        }
      }
    },
    "colorStops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/colorStop"
      }
    },
    "item": {
      "oneOf": [
        {
          "enum": [
            "dir",
            "git",
            "model",
            "context",
            "five_hour",
            "seven_day",
            "in_tok",
            "out_tok",
            "tok_per_min",
            "tok_per_sec",
            "throughput",
            "session_id",
            "session_duration",
            "clock",
            "cost",
            "lines",
            "version",
            "text"
          ]
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "enum": [
                "dir",
                "git",
                "model",
                "context",
                "five_hour",
                "seven_day",
                "in_tok",
                "out_tok",
                "tok_per_min",
                "tok_per_sec",
                "throughput",
                "session_id",
                "session_duration",
                "clock",
                "cost",
                "lines",
                "version",
                "text"
              ],
              "description": "Element to draw."
            },
            "width": {
              "description": "Columns (integer), a percentage like \"50%\", \"auto\" (natural size, default) or \"flex\" (share the leftover space).",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^(auto|flex|[0-9]+%)$"
                }
              ],
              "default": "auto"
            },
            "weight": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "Share of the leftover space among flex items."
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ],
              "default": "left",
              "description": "Alignment of the content inside its width."
            },
            "bar_width": {
              "type": "integer",
              "minimum": 4,
